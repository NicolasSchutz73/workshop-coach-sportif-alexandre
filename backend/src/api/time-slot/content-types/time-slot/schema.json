{
  "kind": "collectionType",
  "collectionName": "time_slots",
  "info": {
    "singularName": "time-slot",
    "pluralName": "time-slots",
    "displayName": "Créneau",
    "description": "Créneaux disponibles pour les séances"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "date",
      "required": true
    },
    "startTime": {
      "type": "time",
      "required": true
    },
    "isAvailable": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "sessionType": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::session-type.session-type",
      "inversedBy": "timeSlots",
      "required": true
    },
    "booking": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::booking.booking",
      "mappedBy": "timeSlot"
    }
  }
}
