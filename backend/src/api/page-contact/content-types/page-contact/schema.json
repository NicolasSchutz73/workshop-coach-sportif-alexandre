{
  "kind": "singleType",
  "collectionName": "pages_contact",
  "info": {
    "singularName": "page-contact",
    "pluralName": "pages-contact",
    "displayName": "Page Contact",
    "description": "Contenu administrable de la page Contact"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nomInterne": {
      "type": "string",
      "required": true,
      "default": "Page Contact"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "partage.seo",
      "required": true
    },
    "entete": {
      "type": "component",
      "repeatable": false,
      "component": "partage.entete-page",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "texteAlternatifImage": {
      "type": "string"
    },
    "objectifsFormulaire": {
      "type": "component",
      "repeatable": true,
      "component": "partage.element-liste",
      "required": true
    },
    "confidentialiteFormulaire": {
      "type": "text",
      "required": true
    }
  }
}
