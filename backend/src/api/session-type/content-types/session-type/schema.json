{
  "kind": "collectionType",
  "collectionName": "session_types",
  "info": {
    "singularName": "session-type",
    "pluralName": "session-types",
    "displayName": "Type de séance",
    "description": "Types de séances proposés à la réservation"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "duration": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "mode": {
      "type": "enumeration",
      "enum": [
        "visio",
        "présentiel"
      ],
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "timeSlots": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::time-slot.time-slot",
      "mappedBy": "sessionType"
    },
    "bookings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking.booking",
      "mappedBy": "sessionType"
    }
  }
}
